      "id": 100,
      "title": "请求概览",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "title": "QPS",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(graphql_requests_total[5m]))",
          "legendFormat": "Total QPS",
          "refId": "A"
        },
        {
          "expr": "sum(rate(graphql_requests_total[5m])) by (datasource)",
          "legendFormat": "{{datasource}}",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
